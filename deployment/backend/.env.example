SECUREZONE_API_HOST=0.0.0.0
SECUREZONE_API_PORT=8080
SECUREZONE_MONGO_DATABASE=securezone
SECUREZONE_MONGO_URI=mongodb://<user>:<url-encoded-password>@mongodb:27017/securezone?authSource=admin
SECUREZONE_XPROTECT_API_KEY=<generate-a-long-random-api-key>
SECUREZONE_QR_PRESENCE_MINUTES=2
SECUREZONE_JWT_SECRET=<generate-at-least-32-random-bytes>
SECUREZONE_JWT_TTL_MINUTES=60
